<decoder name="mikrotik">
  <prematch type="pcre2">^firewall,info|^system,info|^dhcp,info|^critical</prematch>
</decoder>

<decoder name="mikrotik-firewall">
  <parent>mikrotik</parent>
  <use_own_name>true</use_own_name>
  <prematch type="pcre2" offset="after_parent">dstnat:</prematch>
  <regex type="pcre2" offset="after_parent">in:(\S+).*?proto\s+(\S+)\s+\([^)]+\),\s+(\d{1,3}(?:\.\d{1,3}){3}):(\d+)->(\d{1,3}(?:\.\d{1,3}){3}):(\d+)</regex>
  <order>interface,protocol,srcip,srcport,dstip,dstport</order>
</decoder>
